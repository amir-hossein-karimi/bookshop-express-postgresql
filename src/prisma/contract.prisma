// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String
  password  String

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model movie {
  id        Int      @id @default(autoincrement())
  title     String
  director  String
  year      Int

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}